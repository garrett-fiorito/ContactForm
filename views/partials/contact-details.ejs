<dl class="contact-details">
    <dt>First name</dt>
    <dd><%= contact.fname %></dd>

    <dt>Last name</dt>
    <dd><%= contact.lname %></dd>

    <dt>Job title</dt>
    <dd><%= contact.job || "Not provided" %></dd>

    <dt>Company</dt>
    <dd><%= contact.company || "Not provided" %></dd>

    <dt>Email address</dt>
    <dd><%= contact.email || "Not provided" %></dd>

    <dt>LinkedIn address</dt>
    <dd><%= contact.linkedin || "Not provided" %></dd>

    <dt>How we met</dt>
    <dd><%= contact.meeting || "Not provided" %></dd>

    <dt>Other meeting details</dt>
    <dd><%= contact.other || "Not provided" %></dd>

    <dt>Message</dt>
    <dd class="contact-message"><%= contact.message || "Not provided" %></dd>

    <dt>Mailing list</dt>
    <dd><%= contact.mailing === "on" ? "Yes" : "No" %></dd>

    <dt>Email format</dt>
    <dd><%= contact.format === "html" ? "HTML" : "Text" %></dd>

    <dt>Submitted</dt>
    <dd>
        <%= contact.submittedAt.toLocaleString("en-US", {
            timeZone: "America/Los_Angeles",
            timeZoneName: "short"
        }) %>
    </dd>
</dl>